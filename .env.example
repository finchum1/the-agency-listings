# Copy this file to .env and fill in your real Supabase project values.
# The anon key is safe to expose client-side (Supabase's own guidance) —
# access control is enforced by Row Level Security policies, not key secrecy.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secrets (set these in the Vercel dashboard, NOT in this file) ---
# SUPABASE_SERVICE_ROLE_KEY  — Project Settings > API > service_role key.
#   Used only by api/admin/invite-agent.js to create agent accounts. Never
#   prefix this with VITE_ — that would bundle it into the public client.
# RESEND_API_KEY             — from resend.com, used by api/contact.js to email leads.
# LEAD_FROM_EMAIL            — optional, e.g. "Listing Inquiries <onboarding@resend.dev>"
